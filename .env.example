# --- Database ---
# Postgres (production / full): postgresql+psycopg://devblueprint:devblueprint@localhost:5432/devblueprint
# SQLite fallback (8GB-friendly local default): sqlite:///./devblueprint.db
DATABASE_URL=sqlite:///./devblueprint.db

# --- Auth ---
JWT_SECRET=change-me-dev-secret-min-32-chars-long!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- LLM (Mock + OpenAI-ready, §23/§43) ---
# Leave empty for deterministic mock mode (no RAM/GPU cost, ideal for 8GB).
# Set to use real inference:
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# --- Copilot (§V2-31: any OpenAI-compatible provider; free keys: Google AI Studio, Groq) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=hash
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Storage ---
STORAGE_MODE=local
UPLOAD_DIR=./uploads
S3_BUCKET=
AWS_REGION=ap-south-1

# --- App ---
ENV=dev
CORS_ORIGINS=http://localhost:3000
