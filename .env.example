# --- Database ---
# Postgres (production / full): postgresql+psycopg://devblueprint:devblueprint@localhost:5432/devblueprint
# SQLite fallback (8GB-friendly local default): sqlite:///./devblueprint.db
DATABASE_URL=sqlite:///./devblueprint.db

# --- Auth ---
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# Default below is DEV ONLY — app refuses to boot in ENV=prod with it.
JWT_SECRET=change-me-dev-secret-min-32-chars-long!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- LLM (Mock by default; free real keys below, §23/§43) ---
# Leave empty for deterministic mock mode (no RAM/GPU cost, ideal for 8GB).
#
# FREE OPTION A — Google AI Studio (Gemini): no credit card, ~1500 req/day on
# Flash models. Get a key at https://aistudio.google.com/apikey then set:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<your-gemini-key>
#   OPENAI_MODEL=gemini-2.5-flash            (check current model ids in AI Studio)
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   (optional semantic embeddings) EMBEDDING_PROVIDER=openai + OPENAI_EMBED_MODEL=text-embedding-004
#
# FREE OPTION B — Groq (Llama/Qwen, ultra-fast): no credit card.
# Get a key at https://console.groq.com/keys then set:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<your-groq-key>
#   OPENAI_MODEL=llama-3.3-70b-versatile     (check current model ids on Groq console)
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#
# FREE OPTION C — Qwen via OpenRouter (no credit card): key at
# https://openrouter.ai/settings/keys then set:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<your-openrouter-key>
#   OPENAI_MODEL=qwen/qwen3.8-27b        (Qwen ids rotate — confirm a :free
#                                        suffix model at openrouter.ai/models first)
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#
# PAID OPTION — real OpenAI: leave OPENAI_BASE_URL empty.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# --- Copilot (§V2-31: any OpenAI-compatible provider; free keys: Google AI Studio, Groq) ---
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=hash
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Storage ---
STORAGE_MODE=local
UPLOAD_DIR=./uploads
S3_BUCKET=
AWS_REGION=ap-south-1

# --- App ---
ENV=dev
CORS_ORIGINS=http://localhost:3000
